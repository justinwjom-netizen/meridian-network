# ============================================================
# Meridian — environment (copy to .env and fill in)
# .env is gitignored. NEVER commit real keys.
# With none of these set, the stack runs in DEMO mode (mock chain).
# ============================================================

# ---------- Network ----------
HSK_RPC_URL=https://mainnet.hsk.xyz
# Testnet (run deploy:testnet first) — official HashKey Chain testnet:
HSK_TESTNET_RPC=https://testnet.hsk.xyz
HSK_TESTNET_CHAINID=133
# Set HSK_CHAIN_ID to match your target (133=testnet, 177=mainnet). Must match the frontend wallet config.
HSK_CHAIN_ID=133
# Explorer: https://testnet-explorer.hsk.xyz  ·  Faucet: see https://docs.hashkeychain.net

# ---------- Deployer (funded with HSK for gas) ----------
DEPLOYER_PRIVATE_KEY=0x...

# ---------- Agent keys (generate fresh; fund the owner/vault) ----------
VAULT_OWNER_KEY=0x...
STRATEGIST_SESSION_KEY=0x...
SIGNAL_KEY=0x...
RISK_KEY=0x...
EXECUTION_KEY=0x...
AUDITOR_KEY=0x...

# ---------- Real HSK Chain token + DEX addresses (YOU provide from HashKey docs) ----------
USDT_ADDRESS=0x...
HSK_ADDRESS=0x...
WETH_ADDRESS=0x...
HSKSWAP_ROUTER=0x...
HSKSWAP_POOL_HSK_USDT=0x...
HSKSWAP_POOL_WETH_USDT=0x...   # Required by deploy.cjs — allowlisted as a trading pool

# ---------- Policy defaults (token base units; USDT = 6 decimals) ----------
PER_TRADE_CAP=500000000
DAILY_LOSS_LIMIT=100000000
DAILY_AGENT_CAP=20000000
MAX_SLIPPAGE_BPS=100

# ---------- Deployed contract addresses (auto-written to deployments/<network>.json; copy here) ----------
VAULT_ADDRESS=
MANDATE_REGISTRY_ADDRESS=
PNL_ATTESTATION_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=

# ---------- AI agent (free via Groq — https://console.groq.com) ----------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Server ----------
PORT=3001
